<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane fx:controller="Atividade2.EqualizeController"
         maxHeight="-Infinity" maxWidth="-Infinity"
         minHeight="-Infinity" minWidth="-Infinity"
         prefHeight="500.0" prefWidth="800.0"
         tabClosingPolicy="UNAVAILABLE"
         stylesheets="@/css/style.css"
         xmlns="http://javafx.com/javafx/21.0.1"
         xmlns:fx="http://javafx.com/fxml/1">

    <tabs>
        <!-- ABA EQUALIZADOR -->
        <Tab text="Equalizador">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="450.0" prefWidth="780.0">
                    <children>
                        <Label layoutX="300.0" layoutY="20.0" text="Pitty - Equalize" />
                        <Label layoutX="340.0" layoutY="60.0" text="Equalizador" />

                        <HBox layoutX="40.0" layoutY="100.0" spacing="40.0" prefHeight="300.0" prefWidth="700.0">
                            <!-- IMAGEM -->
                            <VBox spacing="15.0" prefWidth="250.0" alignment="CENTER">
                                <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true">
                                    <Image url="@/images/albumPitty.jpg" />
                                </ImageView>
                                <Label text="Álbum: Admirável Chip Novo" style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            </VBox>

                            <!-- FORMULÁRIO -->
                            <VBox spacing="20.0" prefWidth="400.0" alignment="CENTER_LEFT">
                                <VBox spacing="5.0">
                                    <Label fx:id="txtCheiro" text="Cheiro" />
                                    <TextField fx:id="txtfieldCheiro" prefWidth="300.0" promptText="Qual cheiro?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtSolta" text="Solta" />
                                    <TextField fx:id="txtfieldSolta" prefWidth="300.0" promptText="Como soltar?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtdDistracao" text="Instrução" />
                                    <TextField fx:id="txtfieldDistracao" prefWidth="300.0" promptText="Qual instrução?" />
                                </VBox>

                                <Button fx:id="btnequalizadorEnviar"
                                        mnemonicParsing="false" onAction="#equalizadorEnviar"
                                        text="Salvar Equalizador"
                                        prefWidth="300.0" />
                            </VBox>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <!-- ABA MANUAL DE INSTRUÇÃO -->
        <Tab text="Manual">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="450.0" prefWidth="780.0">
                    <children>
                        <Label layoutX="300.0" layoutY="20.0" text="Pitty - Equalize" />
                        <Label layoutX="310.0" layoutY="60.0" text="Manual de Instrução" />

                        <HBox layoutX="40.0" layoutY="100.0" spacing="40.0" prefHeight="300.0" prefWidth="700.0">
                            <!-- IMAGEM -->
                            <VBox spacing="15.0" prefWidth="250.0" alignment="CENTER">
                                <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true">
                                    <Image url="@/images/albumPitty.jpg" />
                                </ImageView>
                                <Label text="Álbum: Admirável Chip Novo" style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            </VBox>

                            <!-- FORMULÁRIO -->
                            <VBox spacing="20.0" prefWidth="400.0" alignment="CENTER_LEFT">
                                <VBox spacing="5.0">
                                    <Label fx:id="txtSonhos" text="Sonhos" />
                                    <TextField fx:id="txtfieldSonhos" prefWidth="300.0" promptText="Quais são seus sonhos?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtGostos" text="Gostos" />
                                    <TextField fx:id="txtfieldGostos" prefWidth="300.0" promptText="Quais são seus gostos?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtPensamentos" text="Pensamentos" />
                                    <TextField fx:id="txtfieldPensamentos" prefWidth="300.0" promptText="Quais são seus pensamentos?" />
                                </VBox>

                                <Button fx:id="btnmanualdeinstrucaoEnviar"
                                        mnemonicParsing="false" onAction="#manualdeinstrucaoEnviar"
                                        text="Salvar Manual"
                                        prefWidth="300.0" />
                            </VBox>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <!-- ABA RITMO -->
        <Tab text="Ritmo">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="450.0" prefWidth="780.0">
                    <children>
                        <Label layoutX="300.0" layoutY="20.0" text="Pitty - Equalize" />
                        <Label layoutX="350.0" layoutY="60.0" text="Ritmo" />

                        <HBox layoutX="40.0" layoutY="100.0" spacing="40.0" prefHeight="300.0" prefWidth="700.0">
                            <!-- IMAGEM -->
                            <VBox spacing="15.0" prefWidth="250.0" alignment="CENTER">
                                <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true">
                                    <Image url="@/images/albumPitty.jpg" />
                                </ImageView>
                                <Label text="Álbum: Admirável Chip Novo" style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            </VBox>

                            <!-- FORMULÁRIO -->
                            <VBox spacing="20.0" prefWidth="400.0" alignment="CENTER_LEFT">
                                <VBox spacing="5.0">
                                    <Label fx:id="txtBalanco" text="Balanço" />
                                    <TextField fx:id="txtfieldBalanco" prefWidth="300.0" promptText="Como é o balanço?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtEnsaiado" text="Ensaiado" />
                                    <TextField fx:id="txtfieldEnsaiado" prefWidth="300.0" promptText="Como foi ensaiado?" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label fx:id="txtEmbalo" text="Embalo" />
                                    <TextField fx:id="txtfieldEmbalo" prefWidth="300.0" promptText="Como é o embalo?" />
                                </VBox>

                                <Button fx:id="btnritmoEnviar"
                                        mnemonicParsing="false" onAction="#ritmoEnviar"
                                        text="Salvar Ritmo"
                                        prefWidth="300.0" />
                            </VBox>
                        </HBox>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>